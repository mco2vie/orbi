/* The resources of the executable: its icon (orbitals-recomp.ico: assets/icon/orbitals.ico copied by tools/build/build.py, else the
   one tools/build/icon.py draws), its manifest (orbitals-recomp.manifest: UTF-8 process code page) and its version information.
   tools/build/build.py --target windows compiles it with the runtime objects. */
1 ICON "orbitals-recomp.ico"
1 24 "orbitals-recomp.manifest"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004L      /* VOS_NT_WINDOWS32 */
FILETYPE 1L          /* VFT_APP */
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"   /* English (US), Unicode */
        {
            VALUE "FileDescription", "Orbitals Recomp"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "orbitals-recomp"
            VALUE "LegalCopyright", "MIT License. See LICENSE and THIRD_PARTY_NOTICES."
            VALUE "OriginalFilename", "orbitals-recomp.exe"
            VALUE "ProductName", "Orbitals Recomp"
            VALUE "ProductVersion", "0.2.0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x0409, 0x04B0
    }
}
